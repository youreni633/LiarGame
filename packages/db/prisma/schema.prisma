generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  googleSub   String   @unique
  email       String?
  displayName String
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sessions    Session[]
  memberships RoomMembership[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model Room {
  id          String   @id @default(cuid())
  code        String   @unique
  hostUserId  String
  status      String   @default("WAITING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  memberships RoomMembership[]
  matches     Match[]
  @@index([hostUserId])
}

model RoomMembership {
  roomId    String
  userId    String
  nickname  String
  isHost    Boolean  @default(false)
  joinedAt  DateTime @default(now())
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([roomId, userId])
}

model Match {
  id          String   @id @default(cuid())
  roomId      String
  revision    Int      @default(0)
  status      String   @default("WAITING")
  snapshot    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  events      GameEvent[]
  commands    ProcessedCommand[]
  @@index([roomId, updatedAt])
}

model GameEvent {
  id          String   @id @default(cuid())
  matchId     String
  sequence    Int
  type        String
  playerId    String?
  payload     Json
  occurredAt  DateTime @default(now())
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  @@unique([matchId, sequence])
}

model ProcessedCommand {
  commandId   String   @id
  matchId     String
  revision    Int
  processedAt DateTime @default(now())
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  @@index([matchId, processedAt])
}
